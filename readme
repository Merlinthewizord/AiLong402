```

## API Documentation

### 1. Initiate Token Deployment

**POST** `/api/v1/deploy/token`

Initiates a token deployment request. Returns 402 with Solana payment address.

**Request Body:**
```json
{
  "tokenName": "MyToken",
  "tokenSymbol": "MTK",
  "description": "A token deployed by an AI agent",
  "imageUrl": "https://example.com/token-image.png",
  "twitter": "https://twitter.com/mytoken",
  "telegram": "https://t.me/mytoken",
  "website": "https://mytoken.com",
  "initialBuyAmount": 0.1,
  "slippageBps": 500,
  "priorityFee": 0.0001,
  "paymentToken": "SOL",
  "webhookUrl": "https://your-agent.com/webhook",
  "agentWallet": "YourAgentWalletAddress..."
}
```

**Response (402):**
```json
{
  "status": 402,
  "message": "Payment Required",
  "deploymentId": "dep_abc123xyz",
  "payment": {
    "address": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU",
    "amount": 0.01,
    "token": "SOL",
    "amountLamports": 10000000,
    "memo": "PUMPFUN_DEPLOY_dep_abc123xyz",
    "expiresAt": "2025-10-28T15:30:00Z",
    "qrCode": "data:image/png;base64,iVBORw0KGgo...",
    "deepLink": "solana:7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU?amount=0.01&memo=PUMPFUN_DEPLOY_dep_abc123xyz"
  },
  "verifyUrl": "/api/v1/deploy/verify/dep_abc123xyz",
  "wsUrl": "wss://api.yourservice.com/ws/payment/dep_abc123xyz"
}
```

### 2. Verify Payment & Execute

**GET** `/api/v1/deploy/verify/{deploymentId}`

Checks payment status and executes deployment if paid.

**Response (200 - Paid):**
```json
{
  "status": "executing",
  "deploymentId": "dep_abc123xyz",
  "paid": true,
  "paidAt": "2025-10-28T15:25:00Z",
  "paymentSignature": "5wHu8W5N4KqgZz3nP8K...",
  "paymentAmount": 0.01,
  "deployment": {
    "status": "processing",
    "estimatedCompletion": "2025-10-28T15:26:00Z"
  }
}
```

**Response (402 - Unpaid):**
```json
{
  "status": "pending_payment",
  "deploymentId": "dep_abc123xyz",
  "paid": false,
  "payment": {
    "address": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU",
    "amount": 0.01,
    "token": "SOL",
    "expiresAt": "2025-10-28T15:30:00Z"
  }
}
```

### 3. Get Deployment Status

**GET** `/api/v1/deploy/status/{deploymentId}`

**Response:**
```json
{
  "deploymentId": "dep_abc123xyz",
  "status": "completed",
  "tokenAddress": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU",
  "signature": "5wHu8W5N4KqgZz3nP8K...",
  "paymentSignature": "3nP8K5wHu8W5N4KqgZz...",
  "marketCap": 50000,
  "bondingCurveProgress": 15.5,
  "createdAt": "2025-10-28T15:26:00Z",
  "links": {
    "pumpfun": "https://pump.fun/7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU",
    "solscan": "https://solscan.io/token/7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU",
    "dexscreener": "https://dexscreener.com/solana/7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU"
  }
}
```

### 4. WebSocket Payment Monitoring

**WS** `wss://api.yourservice.com/ws/payment/{deploymentId}`

Real-time payment status updates.

**Messages:**
```json
{
  "type": "payment_detected",
  "deploymentId": "dep_abc123xyz",
  "signature": "5wHu8W5N4KqgZz3nP8K...",
  "amount": 0.01,
  "confirmations": 1
}

{
  "type": "payment_confirmed",
  "deploymentId": "dep_abc123xyz",
  "signature": "5wHu8W5N4KqgZz3nP8K...",
  "confirmations": 32
}

{
  "type": "deployment_started",
  "deploymentId": "dep_abc123xyz"
}

{
  "type": "deployment_completed",
  "deploymentId": "dep_abc123xyz",
  "tokenAddress": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU"
}
```

## Usage Examples

### Python Agent with Solana.py

```python
from solana.rpc.api import Client
from solana.transaction import Transaction
from solders.keypair import Keypair
from solders.system_program import TransferParams, transfer
from solders.pubkey import Pubkey
import requests
import time
import websocket
import json

class PumpFun402SolanaAgent:
    def __init__(self, base_url, agent_keypair, rpc_url="https://api.mainnet-beta.solana.com"):
        self.base_url = base_url
        self.agent_keypair = agent_keypair
        self.solana_client = Client(rpc_url)
    
    def deploy_token(self, token_data):
        # Add agent wallet to request
        token_data['agentWallet'] = str(self.agent_keypair.pubkey())
        
        # Step 1: Initiate deployment
        response = requests.post(
            f"{self.base_url}/api/v1/deploy/token",
            json=token_data
        )
        
        if response.status_code == 402:
            payment_data = response.json()
            deployment_id = payment_data['deploymentId']
            payment_info = payment_data['payment']
            
            print(f"Payment required: {payment_info['amount']} {payment_info['token']}")
            print(f"Payment address: {payment_info['address']}")
            
            # Step 2: Send SOL payment
            self.send_sol_payment(
                payment_info['address'],
                payment_info['amountLamports'],
                payment_info['memo']
            )
            
            # Step 3: Wait for deployment via WebSocket
            return self.wait_for_deployment_ws(deployment_id)
    
    def send_sol_payment(self, to_address, amount_lamports, memo):
        """Send SOL payment with memo"""
        to_pubkey = Pubkey.from_string(to_address)
        
        # Create transfer instruction
        transfer_ix = transfer(
            TransferParams(
                from_pubkey=self.agent_keypair.pubkey(),
                to_pubkey=to_pubkey,
                lamports=amount_lamports
            )
        )
        
        # Create transaction
        recent_blockhash = self.solana_client.get_latest_blockhash().value.blockhash
        transaction = Transaction(recent_blockhash=recent_blockhash)
        transaction.add(transfer_ix)
        
        # Add memo if provided
        if memo:
            from solders.instruction import Instruction
            memo_program = Pubkey.from_string("MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr")
            memo_ix = Instruction(
                program_id=memo_program,
                data=memo.encode(),
                accounts=[]
            )
            transaction.add(memo_ix)
        
        # Sign and send
        transaction.sign(self.agent_keypair)
        signature = self.solana_client.send_transaction(transaction, self.agent_keypair)
        
        print(f"Payment sent: {signature.value}")
        return signature.value
    
    def wait_for_deployment_ws(self, deployment_id):
        """Wait for deployment completion via WebSocket"""
        ws_url = f"wss://{self.base_url.replace('https://', '').replace('http://', '')}/ws/payment/{deployment_id}"
        
        result = {'completed': False}
        
        def on_message(ws, message):
            data = json.loads(message)
            print(f"Status: {data['type']}")
            
            if data['type'] == 'deployment_completed':
                result['data'] = data
                result['completed'] = True
                ws.close()
        
        def on_error(ws, error):
            print(f"WebSocket error: {error}")
        
        ws = websocket.WebSocketApp(
            ws_url,
            on_message=on_message,
            on_error=on_error
        )
        
        ws.run_forever()
        
        return result.get('data', {})

# Usage
agent_keypair = Keypair.from_base58_string("your_private_key_here")
agent = PumpFun402SolanaAgent(
    "https://api.yourservice.com",
    agent_keypair
)

token = agent.deploy_token({
    "tokenName": "AI Agent Token",
    "tokenSymbol": "AGENT",
    "description": "Deployed by an autonomous agent",
    "imageUrl": "https://example.com/agent.png",
    "initialBuyAmount": 0.1,
    "paymentToken": "SOL"
})

print(f"Token deployed: {token['tokenAddress']}")
```

### JavaScript/Node.js Example with @solana/web3.js

```javascript
const { Connection, Keypair, Transaction, SystemProgram, PublicKey, sendAndConfirmTransaction } = require('@solana/web3.js');
const axios = require('axios');
const WebSocket = require('ws');
const bs58 = require('bs58');

class PumpFun402SolanaAgent {
    constructor(baseUrl, agentKeypair, rpcUrl = 'https://api.mainnet-beta.solana.com') {
        this.baseUrl = baseUrl;
        this.agentKeypair = agentKeypair;
        this.connection = new Connection(rpcUrl, 'confirmed');
    }

    async deployToken(tokenData) {
        // Add agent wallet
        tokenData.agentWallet = this.agentKeypair.publicKey.toBase58();

        // Step 1: Initiate deployment
        try {
            await axios.post(`${this.baseUrl}/api/v1/deploy/token`, tokenData);
        } catch (error) {
            if (error.response?.status === 402) {
                const { deploymentId, payment } = error.response.data;
                
                console.log(`Payment required: ${payment.amount} ${payment.token}`);
                
                // Step 2: Send payment
                await this.sendSolPayment(
                    payment.address,
                    payment.amountLamports,
                    payment.memo
                );
                
                // Step 3: Wait for deployment
                return await this.waitForDeploymentWS(deploymentId);
            }
            throw error;
        }
    }

    async sendSolPayment(toAddress, amountLamports, memo) {
        const toPubkey = new PublicKey(toAddress);
        
        // Create transfer instruction
        const transaction = new Transaction().add(
            SystemProgram.transfer({
                fromPubkey: this.agentKeypair.publicKey,
                toPubkey: toPubkey,
                lamports: amountLamports
            })
        );
        
        // Add memo if provided
        if (memo) {
            const memoProgram = new PublicKey('MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr');
            transaction.add({
                keys: [],
                programId: memoProgram,
                data: Buffer.from(memo, 'utf8')
            });
        }
        
        // Send transaction
        const signature = await sendAndConfirmTransaction(
            this.connection,
            transaction,
            [this.agentKeypair]
        );
        
        console.log(`Payment sent: ${signature}`);
        return signature;
    }

    async waitForDeploymentWS(deploymentId) {
        return new Promise((resolve, reject) => {
            const wsUrl = `${this.baseUrl.replace('https', 'wss').replace('http', 'ws')}/ws/payment/${deploymentId}`;
            const ws = new WebSocket(wsUrl);
            
            const timeout = setTimeout(() => {
                ws.close();
                reject(new Error('Deployment timeout'));
            }, 600000); // 10 minutes
            
            ws.on('message', (data) => {
                const message = JSON.parse(data);
                console.log(`Status: ${message.type}`);
                
                if (message.type === 'deployment_completed') {
                    clearTimeout(timeout);
                    ws.close();
                    resolve(message);
                } else if (message.type === 'deployment_failed') {
                    clearTimeout(timeout);
                    ws.close();
                    reject(new Error(message.error));
                }
            });
            
            ws.on('error', (error) => {
                clearTimeout(timeout);
                reject(error);
            });
        });
    }
}

// Usage
(async () => {
    const agentKeypair = Keypair.fromSecretKey(
        bs58.decode('your_private_key_here')
    );
    
    const agent = new PumpFun402SolanaAgent(
        'https://api.yourservice.com',
        agentKeypair
    );

    const token = await agent.deployToken({
        tokenName: 'Agent Token',
        tokenSymbol: 'AGT',
        description: 'AI-deployed token',
        imageUrl: 'https://example.com/token.png',
        initialBuyAmount: 0.1,
        paymentToken: 'SOL'
    });

    console.log(`Deployed: ${token.tokenAddress}`);
})();
```

