{
  "name": "eliza-pumpfun-402",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ElizaOS agent for Pump.fun token deployment with 402 payments",
  "engines": {
    "node": ">=23.3.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "packages/*",
    "agent",
    "server"
  ],
  "scripts": {
    "postinstall": "pnpm build",
    "start": "turbo run start --filter=./agent --log-prefix=none",
    "start:agent": "pnpm --filter agent start",
    "start:server": "pnpm --filter server start",
    "start:all": "concurrently \"pnpm start:agent\" \"pnpm start:server\"",
    "dev": "turbo run dev --parallel",
    "dev:agent": "pnpm --filter agent dev",
    "dev:server": "pnpm --filter server dev",
    "build": "turbo run build",
    "build:agent": "turbo run build --filter=./agent",
    "build:plugins": "turbo run build --filter=./packages/*",
    "test": "turbo run test --concurrency=3",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "clean:dist": "find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "typecheck": "turbo run typecheck",
    "deploy": "pnpm build && pnpm start:all"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
```

