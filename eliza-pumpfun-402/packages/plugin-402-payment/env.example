```bash
# =============================================================================
# ELIZA 402 AGENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# -----------------------------------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# -----------------------------------------------------------------------------
# SOLANA CONFIGURATION
# -----------------------------------------------------------------------------
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com

# Payment wallet - receives SOL/USDC payments
# Generate with: solana-keygen new
PAYMENT_WALLET_ADDRESS=
PAYMENT_WALLET_PRIVATE_KEY=

# Deployment wallet - deploys tokens on Pump.fun
DEPLOYMENT_WALLET_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# PUMP.FUN CONFIGURATION
# -----------------------------------------------------------------------------
PUMPFUN_API_URL=https://pumpportal.fun/api
PUMPFUN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# PAYMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Pricing
PRICE_PER_DEPLOYMENT_SOL=0.01
PRICE_PER_DEPLOYMENT_USDC=1.5

# USDC Token Address (Mainnet)
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Payment settings
PAYMENT_TIMEOUT=300
PAYMENT_CONFIRMATION_BLOCKS=1
ENABLE_ESCROW=false
ESCROW_PROGRAM_ID=

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/pumpfun402

# Or SQLite (for development)
# DATABASE_URL=sqlite://./data/pumpfun402.db

# -----------------------------------------------------------------------------
# AI MODEL CONFIGURATION
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Or Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Or Local (Ollama)
# OLLAMA_SERVER_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# -----------------------------------------------------------------------------
# CLIENT CONFIGURATION
# -----------------------------------------------------------------------------
# Direct Client (HTTP API)
DIRECT_PORT=3000
DIRECT_ENABLED=true

# Twitter/X Client
TWITTER_ENABLED=false
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=
# OR use cookies (more secure)
# TWITTER_COOKIES=

# Discord Client
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_API_TOKEN=

# Telegram Client
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# 402 SERVER CONFIGURATION
# -----------------------------------------------------------------------------
SERVER_PORT=3402
SERVER_HOST=0.0.0.0
CORS_ORIGIN=*

# API Security
API_KEY_SALT=
JWT_SECRET=
WEBHOOK_SECRET=

# Rate Limiting
MAX_REQUESTS_PER_HOUR=100
MAX_REQUESTS_PER_IP=50

# WebSocket
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL=30000

# -----------------------------------------------------------------------------
# MONITORING & LOGGING
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logging
LOG_FILE=./logs/agent.log
LOG_MAX_FILES=7
LOG_MAX_SIZE=10m

# -----------------------------------------------------------------------------
# OPTIONAL FEATURES
# -----------------------------------------------------------------------------
# Image Generation (for token images)
ENABLE_IMAGE_GENERATION=false
STABILITY_API_KEY=

# Analytics
ENABLE_ANALYTICS=false
ANALYTICS_API_KEY=

# Notifications
ENABLE_NOTIFICATIONS=false
NOTIFICATION_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Debug mode
DEBUG=false
VERBOSE=false

# Test mode
TEST_MODE=false
MOCK_PAYMENTS=false
SKIP_BLOCKCHAIN=false
```

---
